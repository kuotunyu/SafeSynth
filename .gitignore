# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*credentials*
*secret*
*.pem
*.token
kaggle.json

# --- Private working notes (filename alone reveals intent) ---
interview*.md
INTERVIEW_PREP.md
*.discarded-*

# --- Large data & outputs ---
# Bulk data actually lives on D:\sdg-data\02-safesynth (see configs/paths.yaml);
# these rules exist so an accidental local copy never reaches git.
# Leading "/" anchors them to the repo root — an unanchored "data/" would also
# swallow src/data/, which is source code.
/data/
/runs/
/tmp/
/outputs/
# Runtime watchdog telemetry contains local process names and absolute paths;
# keep the compact final reports, not these append-only machine logs.
/reports/rfdetr_probe_health.jsonl
/reports/train_smoke_health.jsonl
# results/ must stay tracked as a directory so results/.gitkeep survives:
# ignore its CONTENTS, not the directory itself.
/results/*
!/results/.gitkeep
# ...except the small artefacts the reports are checked against. EVAL-12 says
# every number in a report must be re-aggregatable from detection_metrics.csv,
# and scripts/verify_readme.py enforces that against this file - so a clone
# without it cannot verify the README at all. These are kilobytes.
!/results/detection_metrics.csv
!/results/predictions_index.json
!/results/rfdetr_detection_metrics.csv
!/results/rfdetr_predictions_index.json
!/results/colab/
/results/colab/**/*.safetensors
/results/colab/**/*.pt
/results/colab/**/*.bin
# The raw per-arm detection dumps are ~32 MB each and belong on the data drive
# (D:/sdg-data/...); scripts/dump_predictions.py writes them there and
# results/predictions/ only ever holds working copies.
/results/predictions/

*.tar
*.tar.gz
*.zip

# --- Model weights ---
*.ckpt
*.safetensors
*.pt
*.pth
*.onnx
*.gguf
*.bin

# --- Generated imagery (synthetic images live on D:, previews are curated by hand) ---
# reports/figures/ IS tracked — those are the small curated grids we cite in the README.
/assets/*
!/assets/.gitkeep
# DEMO-04: the README's demo GIF is the one asset that ships.
!/assets/demo.gif

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/

# --- Tooling / OS ---
.worktrees/
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
desktop.ini
